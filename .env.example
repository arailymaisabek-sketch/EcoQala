# ============================================================================
# EcoQala Environment Variables Template
# ============================================================================

# AI Vision Provider ('gemini' or 'openai')
AI_PROVIDER=gemini

# Google Gemini Vision Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.8-flash

# OpenAI Vision Configuration (Optional alternative provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o-mini

# Supabase Database & Storage Configuration (Optional for cloud persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Solana Network (devnet or mainnet-beta)
SOLANA_NETWORK=devnet

# Application Public Host
APP_URL=http://localhost:3000
